# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def patch_file_picker_ios_phpicker_group
  plugin_path = File.join(
    __dir__,
    'Pods',
    '.symlinks',
    'plugins',
    'file_picker',
    'ios',
    'file_picker',
    'Sources',
    'file_picker',
    'FilePickerPlugin.m'
  )
  return unless File.exist?(plugin_path)

  source = File.read(plugin_path)
  return if source.include?('leavePickerGroup')

  patched = source.dup
  patched.sub!(
    '    self.group = dispatch_group_create();',
    "    self.group = dispatch_group_create();\n    dispatch_group_t pickerGroup = self.group;"
  )
  patched.sub!(
    '        dispatch_group_enter(_group);',
    '        dispatch_group_enter(pickerGroup);'
  )
  patched.sub!(
    "        PHPickerResult * result = [results objectAtIndex:index];\n        \n        dispatch_async(processQueue, ^{",
    "        PHPickerResult * result = [results objectAtIndex:index];\n        __block BOOL didLeavePickerGroup = NO;\n        void (^leavePickerGroup)(void) = ^{\n            @synchronized (result) {\n                if (didLeavePickerGroup) {\n                    return;\n                }\n                didLeavePickerGroup = YES;\n            }\n            dispatch_group_leave(pickerGroup);\n        };\n        \n        dispatch_async(processQueue, ^{"
  )
  patched.gsub!('dispatch_group_leave(self->_group);', 'leavePickerGroup();')
  patched.sub!(
    '    dispatch_group_notify(_group, dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0),^{',
    '    dispatch_group_notify(pickerGroup, dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0),^{'
  )

  if patched == source
    Pod::UI.warn 'file_picker iOS PHPicker group patch was not applied; plugin source layout may have changed.'
    return
  end

  File.write(plugin_path, patched)
  Pod::UI.puts 'Applied file_picker iOS PHPicker dispatch_group crash patch.'
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # 与 screen_protector 同源；仅原生调用，避免 Flutter 插件注册阶段 initial(nil) 黑屏。
  pod 'ScreenProtectorKit', '1.5.1'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  patch_file_picker_ios_phpicker_group

  # 注意：不要在这里主动调用 flutter_soloud 的 build_cmake.sh。
  # 该脚本必须由 Xcode 构建时调用（依赖 PLATFORM_NAME 等环境变量），
  # 在 post_install 阶段裸跑会立刻报 "PLATFORM_NAME is not set" 并把
  # pod install 整个搞挂。
  #
  # flutter_soloud 4.0.5 已支持 Swift Package Manager + Xcode 构建时
  # 自动触发 CMake，无需 Podfile 层兜底。
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
